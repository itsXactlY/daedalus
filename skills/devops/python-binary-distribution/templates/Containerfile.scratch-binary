# python-binary-distribution / Containerfile.scratch-binary
#
# Starter Containerfile for distributing a Python app as a Nuitka --onefile
# binary inside a FROM scratch container. Replace `app.bin` with your binary,
# `app` with your service name, `9091` with your port.
#
# Build pipeline (host side):
#   1. python -m venv /tmp/build-venv
#   2. /tmp/build-venv/bin/pip install nuitka ordered-set <deps>
#   3. /tmp/build-venv/bin/python -m nuitka \
#        --onefile --output-filename=app.bin \
#        --include-package=<deps> --remove-output --assume-yes-for-downloads \
#        main.py
#   4. populate ./lib/ with host glibc libs (see references/glibc-libs-for-scratch-container.md)
#   5. podman build -f Containerfile -t localhost/app:latest .

FROM scratch

# ── Dynamic linker (ELF interpreter the binary expects at /lib64) ──────
COPY lib/ld-linux-x86-64.so.2 /lib64/ld-linux-x86-64.so.2

# ── glibc + standard libs ──────────────────────────────────────────────
# CRITICAL: glibc on Arch/Garuda searches /usr/lib ONLY (NOT /lib,
# NOT /lib64 like Debian). Putting these in /lib/ silently fails at
# runtime. See references/glibc-libs-for-scratch-container.md.
COPY lib/libc.so.6         /usr/lib/libc.so.6
COPY lib/libm.so.6         /usr/lib/libm.so.6
COPY lib/libdl.so.2        /usr/lib/libdl.so.2
COPY lib/libpthread.so.0   /usr/lib/libpthread.so.0
COPY lib/librt.so.1        /usr/lib/librt.so.1
COPY lib/libutil.so.1      /usr/lib/libutil.so.1
COPY lib/libresolv.so.2    /usr/lib/libresolv.so.2

# ── Python stdlib transitive deps ──────────────────────────────────────
COPY lib/libz.so.1         /usr/lib/libz.so.1
COPY lib/libssl.so.3       /usr/lib/libssl.so.3
COPY lib/libcrypto.so.3    /usr/lib/libcrypto.so.3
COPY lib/libffi.so.8       /usr/lib/libffi.so.8
COPY lib/libexpat.so.1     /usr/lib/libexpat.so.1
COPY lib/libsqlite3.so.0   /usr/lib/libsqlite3.so.0
COPY lib/libgcc_s.so.1     /usr/lib/libgcc_s.so.1

# ── The binary IS the runtime ──────────────────────────────────────────
# ~20 MB single ELF, no Python on target, no source code anywhere.
COPY app.bin /usr/local/bin/app

# ── Default runtime config ────────────────────────────────────────────
# In production, operators bind-mount %h/.appname/runtime.env
# at /etc/app/runtime.env to override these.
COPY runtime.env /etc/app/runtime.env

# ── Data volume ────────────────────────────────────────────────────────
# Bind-mount %h/.appname/data here in the quadlet:
#   Volume=%h/.appname/data:/var/lib/app:z
# Source code should read: DATA_DIR = Path(os.environ.get('APP_DATA_DIR', '/var/lib/app'))
VOLUME ["/var/lib/app"]

# ── Default env (overridden by runtime.env + quadlet Environment=) ─────
ENV APP_DATA_DIR=/var/lib/app
ENV APP_LOG_LEVEL=INFO

# ── Locale: ASCII default crashes Unicode banners ─────────────────────
# Set these via quadlet Environment= too (overrides ENV):
#   Environment=LC_ALL=C.UTF-8
#   Environment=LANG=C.UTF-8
#   Environment=PYTHONIOENCODING=utf-8

EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/app"]
CMD ["--help"]
