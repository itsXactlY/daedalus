# App runtime environment — defaults shipped with the FROM scratch image.
# Operators copy this to ~/.appname/runtime.env and edit for their machine.
# The container's quadlet `EnvironmentFile=` directive sources this file.

# ── Logging ──────────────────────────────────────────────────────────
APP_LOG_LEVEL=INFO

# ── Data directory ───────────────────────────────────────────────────
# Override when running the binary directly on the host (not in container).
# In the container, /var/lib/app is the bind-mounted default from the quadlet.
# APP_DATA_DIR=/var/lib/app

# ── Federation / identity ────────────────────────────────────────────
# Override per-pod for multi-gateway setups.
# APP_GATEWAY_ID=app-01
