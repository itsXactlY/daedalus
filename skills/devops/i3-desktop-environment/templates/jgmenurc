# jgmenurc — Hermelin amber/slate theme
# Drop into ~/.config/jgmenu/jgmenurc

# Position — opens at pointer
position_mode = pointer
horizontal_padding = 12
vertical_padding = 12

# Sizing
item_height = 28
item_padding_x = 14
arrow_width = 10

# Look
menu_margin = 4
corner_radius = 6
arrow_string = ▸

# Font (use a font that exists on the system)
font = Sans 11

# Colors — Hermelin amber/slate
# Dark slate background, amber accents
color_menu_bg = #1e2233
color_menu_bg_to = #1e2233
color_menu_border = #3a3f55
color_norm_fg = #d3dae3
color_norm_bg = #1e2233
color_sel_fg = #08080a
color_sel_bg = #f9a825
color_sel_border = #f9a825
color_sep_fg = #3a3f55
color_title_fg = #f9a825
color_title_bg = #1e2233
